    {
      "name": "omni submits a background interaction",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "requestBody": {
            "prompt": "A boat",
            "resolution": "360p",
            "duration": 3,
            "model": "gemini-omni-1.2-flash"
          },
          "requestHeaders": {
            "Content-Type": "application/json",
            "Accept": ""
          },
          "action": "text_to_video",
          "model": "gemini-omni-1.2-flash",
          "upstreamModel": "gemini-omni-1.2-flash",
          "baseUrl": "https://generativelanguage.googleapis.com",
          "apiKey": "test-key",
          "authHeader": "Bearer test-key",
          "upstream": {
            "kind": "vendor"
          },
          "config": {},
          "files": [],
          "publicTaskId": "task_public"
        }
      ],
      "expected": {
        "url": "https://generativelanguage.googleapis.com/v1beta/interactions",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "x-goog-api-key": "test-key"
        },
        "body": {
          "model": "gemini-omni-1.2-flash",
          "input": [
            {
              "type": "text",
              "text": "A boat"
            }
          ],
          "response_format": {
            "type": "video",
            "aspect_ratio": "16:9",
            "resolution": "360p",
            "duration": "3s"
          },
          "background": true,
          "store": true,
          "generation_config": {
            "video_config": {
              "task": "text_to_video"
            }
          }
        },
        "action": "text_to_video"
      }
    },
