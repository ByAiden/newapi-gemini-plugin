          "requestHeaders": {
            "Content-Type": "application/json",
            "Accept": ""
          },
          "action": "decide",
          "model": "gemini-decision-1",
          "upstreamModel": "gemini-decision-1",
          "baseUrl": "https://generativelanguage.googleapis.com",
