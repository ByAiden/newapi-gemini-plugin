{
  "cases": [
    {
      "name": "decision request goes to /v1beta/decisions with the mapped model",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "requestBody": {
            "model": "gemini-decision-1",
            "input": "The mug arrived cracked.",
            "questions": {
              "damaged": {
                "type": "noul",
                "instructions": "Damaged?"
              }
            }
          },
          "requestHeaders": {
            "Content-Type": "application/json",
            "Accept": ""
          },
          "action": "decide",
          "model": "decision",
          "upstreamModel": "gemini-decision-1",
          "baseUrl": "https://generativelanguage.googleapis.com",
          "apiKey": "test-key",
          "authHeader": "Bearer test-key",
          "upstream": {
            "kind": "vendor"
          },
          "config": {},
          "files": [],
          "publicTaskId": "task_public"
        }
      ],
      "expected": {
        "url": "https://generativelanguage.googleapis.com/v1beta/decisions",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "x-goog-api-key": "test-key"
        },
        "body": {
          "model": "gemini-decision-1",
          "input": "The mug arrived cracked.",
          "questions": {
            "damaged": {
              "type": "noul",
              "instructions": "Damaged?"
            }
          }
        },
        "action": "decide"
      }
    },
