        }
      }
    },
    {
      "name": "omni completed interaction succeeds",
      "hook": "parseTaskResult",
      "args": [
        {
          "taskId": "v1_abc",
          "model": "gemini-omni-1.2-flash",
          "upstreamModel": "gemini-omni-1.2-flash",
          "baseUrl": "https://generativelanguage.googleapis.com",
          "apiKey": "test-key",
          "upstream": {
            "kind": "vendor"
          }
        },
        {
          "id": "v1_abc",
          "object": "interaction",
          "status": "completed",
          "usage": {
            "total_input_tokens": 14,
            "output_tokens_by_modality": [
              {
                "modality": "video",
                "tokens": 5793
              }
            ],
            "total_thought_tokens": 535
          },
          "steps": [
            {
              "type": "user_input",
              "content": [
                {
                  "type": "text",
                  "text": "x"
                }
              ]
            },
            {
              "type": "model_output",
              "content": [
                {
                  "type": "video",
                  "mime_type": "video/mp4",
                  "data": "AAAA"
                }
              ]
            }
          ]
        },
        {
          "status": 200,
          "headers": {}
        }
      ],
      "expected": {
        "status": "SUCCESS",
        "progress": "100%"
      }
    },
